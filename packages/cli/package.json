{
  "name": "@mingxu/cli",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "MingXu CLI package and executable.",
  "bin": {
    "mingxu": "./dist/entry.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "LICENSES"
  ],
  "dependencies": {
    "@mingxu/tui": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "marked": "^18.0.7",
    "string-width": "^8.2.2",
    "zod": "^3.25.67"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-dist.mjs",
    "build": "node ../../scripts/build-cli.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build",
    "pack:staged": "node ../../scripts/pack-cli.mjs",
    "pack:dry-run": "node ../../scripts/pack-cli.mjs --dry-run"
  }
}
