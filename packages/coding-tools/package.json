{
  "name": "@mingxu/coding-tools",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Standalone official MingXu coding tools plugin skeleton.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node ../../scripts/clean-dist.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mingxu/plugin-sdk": "workspace:*"
  },
  "files": [
    "dist",
    "index.js",
    "mingxu.plugin.json",
    "src",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "LICENSES"
  ]
}
